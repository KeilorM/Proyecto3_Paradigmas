# Doxyfile - documentación técnica del proyecto (Haskell mediante filtro de entrada)
PROJECT_NAME           = "Pipeline Funcional-Lógico: Haskell → Prolog → UI"
PROJECT_BRIEF          = "Proyecto Integrador - Paradigmas de Programación"
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = Spanish
INPUT_ENCODING         = UTF-8
INPUT                  = README.md docs/arquitectura.dox app src test
FILE_PATTERNS          = *.hs *.md *.dox
RECURSIVE              = YES
# Haskell no tiene analizador en Doxygen: se trata como C++ tras pasar por el filtro.
EXTENSION_MAPPING      = hs=C++
FILTER_PATTERNS        = *.hs="runghc tools/DoxyFilter.hs"
EXTRACT_ALL            = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
WARN_IF_UNDOCUMENTED   = NO
QUIET                  = YES
